<!doctype html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="Sistema Jurídico — informação jurídica clara e acessível.">
    <title>Casos | Sistema Jurídico</title>
    <link rel="icon" href="/favicon.svg">
    <link rel="stylesheet" href="/styles.css">
</head>

<body><a class="skip-link" href="#conteudo">Pular para o conteúdo</a>
    <div class="utility-bar">
        <div class="container utility-inner">
            <p>Informação jurídica clara, confiável e acessível.</p>
            <div aria-label="Opções de acessibilidade"><span>A−</span><span>A+</span><span>Alto contraste</span></div>
        </div>
    </div>
    <header class="site-header">
        <div class="container header-inner"><a class="brand" href="/index.html"><span
                    class="brand-mark">SJ</span><span><strong>Sistema Jurídico</strong><small>Conhecimento que
                        orienta</small></span></a>
            <nav class="main-nav" aria-label="Navegação principal"><a href="/index.html">Início</a><a class="active"
                    href="/casos.html">Casos</a><a href="/empresas.html">Empresas</a><a
                    href="/tribunais.html">Tribunais</a><a href="/curiosidades.html">Curiosidades</a></nav>
            <div class="header-actions"><a class="icon-link" href="/busca.html" aria-label="Pesquisar">⌕</a><a
                    class="button" href="/login.html">Entrar</a></div>
        </div>
    </header>
    <main id="conteudo">
        <section class="page-hero">
            <div class="container"><span class="eyebrow">Base de casos</span>
                <h1>Acompanhe processos relevantes</h1>
                <p>Consulte informações públicas organizadas por área, tribunal e situação processual.</p>
                <form class="search" action="/busca.html"><input name="q" aria-label="Pesquisar casos"
                        placeholder="Número do processo, assunto ou tribunal"><button>Pesquisar</button></form>
            </div>
        </section>
        <section class="section">
            <div class="container">
                <div class="filters"><span class="filter active">Todos</span><span class="filter">Consumidor</span><span
                        class="filter">Trabalho</span><span class="filter">Empresarial</span></div>
                <div class="grid grid-3">
                    <% for (const caso of Casos) { %>
                        <article class="card case-card">
                            <div class="card-top">
                                <span class="tag">
                                    <%= caso.tipodoproduto || caso.tipodoprocesso %>
                                </span>
                            </div>
                            <% if (caso.foto) { %>
                                <% const fotoUrl = typeof caso.foto === 'string' && caso.foto.startsWith('data:')
                                    ? caso.foto : `/${caso.foto}`; %>
                                <img class="case-img" src="<%= fotoUrl %>" alt="">
                            <% } %>
                            <h3><%= caso.descricaodoprocesso %></h3>
                            <small>Processo nº <%= String(caso._id).slice(-6) %></small>
                            <p class="court"><%= caso.marca %></p>
                        </article>
                    <% } %>
                </div>
            </div>
        </section>
    </main>
    <footer class="site-footer">
        <div class="container footer-grid">
            <div><a class="brand footer-brand" href="/index.html"><span class="brand-mark">SJ</span><strong>Sistema
                        Jurídico</strong></a>
                <p>Democratizando o acesso à informação jurídica com clareza, contexto e responsabilidade.</p>
            </div>
            <div><strong>Explore</strong><a href="/casos.html">Casos</a><a href="/empresas.html">Empresas</a><a
                    href="/tribunais.html">Tribunais</a></div>
            <div><strong>Institucional</strong><a href="#">Sobre o projeto</a><a href="#">Fontes e metodologia</a><a
                    href="#">Privacidade</a></div>
            <div><strong>Receba o boletim</strong>
                <p>Análises e novidades jurídicas, toda semana.</p>
                <form class="newsletter"><input type="email" aria-label="Seu e-mail" placeholder="seu@email.com"><button
                        aria-label="Assinar">→</button></form>
            </div>
        </div>
        <div class="footer-bottom">
            <div class="container"><span>© 2025 Sistema Jurídico.</span><span>Não substitui orientação jurídica
                    profissional.</span></div>
        </div>
    </footer>
</body>

</html>